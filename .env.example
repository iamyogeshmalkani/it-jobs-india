# Copy to .env for local runs. In GitHub Actions, set the first three as repository secrets
# and any of the rest as repository variables.

# --- Required ---------------------------------------------------------------
# Supabase/Neon Postgres connection string (use the pooled/session URL). Tables are
# prefixed job_, so the dealbot database works too.
# Leave empty locally to use a SQLite file (jobbot.db).
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
# Public channel: @yourchannel (or the numeric -100... id). The bot must be an admin
# with "Post messages" and "Edit messages of others".
TELEGRAM_CHANNEL_ID=

# --- Sources ----------------------------------------------------------------
ENABLE_UNSTOP=1
UNSTOP_PAGES=20        # max pages of 100 listings per type; stops early at the last page
# COMPANIES_FILE=data/companies.json

# --- Filters ----------------------------------------------------------------
SKIP_UNPAID=1          # 1 = never post unpaid internships
MAX_JOB_AGE_DAYS=10    # skip anything published longer ago
# Deadlines must be tomorrow (IST) or later; today's and past deadlines are never posted.
COMPANY_COOLDOWN_HOURS=0   # 0 = off; N = at most one post per company per N hours
REPOST_COOLDOWN_DAYS=30    # same company + title is not posted again within this

# --- Posting ----------------------------------------------------------------
# Every run posts ALL new jobs. These limits are off by default (0 = off).
POST_INTERVAL_MINUTES=0    # minimum minutes between runs that post
MAX_POSTS_PER_DAY=0        # cap per IST day
QUIET_START_HOUR=0     # IST quiet window [start, end); equal values = no quiet hours
QUIET_END_HOUR=0       # e.g. 0 and 7 = no posting from 00:00 until 07:00
DRY_RUN=0              # 1 = print Telegram calls instead of sending
